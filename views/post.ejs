<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <title>投稿餐廳</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/index.css">
    <link rel="stylesheet" href="/post.css">
</head>
<body>
    <nav><a href="/" class="logo">城市餐桌</a></nav>

    <div class="post-box">
        <h2>📮 投稿新餐廳</h2>

        <label>餐廳名稱</label>
        <input type="text" id="pName" placeholder="例如：鼎泰豐">

        <label>詳細地址</label>
        <input type="text" id="pAddr" placeholder="台北市信義區...">

        <label>聯絡電話</label>
        <input type="text" id="pPhone" placeholder="02-1234-5678">

        <label>美食圖片網址</label>
        <input type="text" id="pImg" placeholder="貼上 jpg/png 圖片連結">

        <label>推薦原因</label>
        <textarea id="pDesc" placeholder="例如：小籠包爆汁，服務也很好"></textarea>

        <button onclick="publish()" class="btn-publish">確認發布</button>
    </div>

    <script>
    // ✅ 統一把「臺」改成「台」，避免城市比對/搜尋不一致
    function toTai(s) {
        return (s || '').replaceAll('臺', '台').trim();
    }

    // ✅ 從地址解析出 city / district（支援：市+區、縣+鄉/鎮/市）
    function parseCityDistrict(addr) {
        addr = toTai(addr);

        let city = '';
        let district = '';

        // ---- 市：例如 台中市北區... / 台北市信義區...
        if (addr.includes('市')) {
            const cityEnd = addr.indexOf('市') + 1;
            city = addr.slice(0, cityEnd);

            // 市底下通常是「區」
            if (addr.includes('區')) {
                const districtEnd = addr.indexOf('區') + 1;
                district = addr.slice(cityEnd, districtEnd);
            } else {
                // 有些地址不含區（例如只到市），就先留空
                district = '';
            }

        // ---- 縣：例如 宜蘭縣羅東鎮... / 南投縣埔里鎮... / 花蓮縣吉安鄉...
        } else if (addr.includes('縣')) {
            const cityEnd = addr.indexOf('縣') + 1;
            city = addr.slice(0, cityEnd);

            // 縣底下可能是「鄉 / 鎮 / 市」
            if (addr.includes('鄉')) {
                district = addr.slice(cityEnd, addr.indexOf('鄉') + 1);
            } else if (addr.includes('鎮')) {
                district = addr.slice(cityEnd, addr.indexOf('鎮') + 1);
            } else if (addr.slice(cityEnd).includes('市')) {
                // 注意：縣後面也可能出現「市」（例如 彰化縣員林市...）
                const sub = addr.slice(cityEnd);
                district = sub.slice(0, sub.indexOf('市') + 1);
            } else {
                district = '';
            }
        }

        return { city, district };
    }

    async function publish() {
        const name = document.getElementById('pName').value.trim();
        let addr = document.getElementById('pAddr').value.trim();

        // ✅ 前端防呆：至少要有名稱+地址
        if (!name || !addr) {
            alert('請至少填寫「餐廳名稱」與「詳細地址」');
            return;
        }

        // ✅ 解析 city / district（已內建把「臺」轉「台」）
        const { city, district } = parseCityDistrict(addr);

        // ✅ 如果連 city 都抓不到，代表地址格式太怪，直接提示使用者補完整
        if (!city) {
            alert('地址格式看不懂，請包含「xx市/xx縣」例如：台中市北區育才北路69號');
            return;
        }

        const data = {
            name,
            address: toTai(addr),
            phone: document.getElementById('pPhone').value.trim(),
            city,
            district,
            image_url: document.getElementById('pImg').value.trim(),
            description: document.getElementById('pDesc').value.trim()
        };

        const res = await fetch('/api/restaurants', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        // ✅ 不管成功/失敗，都嘗試讀訊息
        let result = {};
        try {
            result = await res.json();
        } catch (e) {
            result = { success: false, message: '伺服器回應格式錯誤' };
        }

        // ✅ 用 res.ok + success 雙保險（後端回 400 也能正確提示）
        if (!res.ok || !result.success) {
            alert(result.message || '投稿失敗，請稍後再試');
            return;
        }

        alert(result.message || '投稿成功！');
        location.href = '/';
    }
</script>
</body>
</html>
